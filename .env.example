# Copy to .env.local for local development. Never commit real values.
#
# The Vite mode decides which file is read:
#   pnpm dev               -> .env, .env.local
#   pnpm build:staging     -> .env.staging      (or CI variables for the "staging" environment)
#   pnpm build:production  -> .env.production   (or CI variables for the "production" environment)
#
# Both values are public (they ship in the app bundle). Access is enforced by row-level security.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<anon or publishable key from Supabase > Project Settings > API>
